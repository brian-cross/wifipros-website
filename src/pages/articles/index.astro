---
import { getCollection } from "astro:content";
import Eyebrow from "../../components/Eyebrow.astro";
import Layout from "../../components/layouts/Layout.astro";
import Section from "../../components/Section.astro";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const dateFormatter = new Intl.DateTimeFormat("en-CA", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  title="Articles | Wi-Fi Pros"
  description="Networking guides and tips from Wi-Fi Pros — Wi-Fi coverage, VLANs, cabling, and connectivity for homes and acreages in the greater Edmonton area."
>
  <Section border={false} class="pt-20">
    <Eyebrow> Guides & Tips </Eyebrow>
    <h1>Articles</h1>
    <p class="mt-5 text-slate max-w-xl text-lg">
      Networking guides and advice from our team — Wi-Fi coverage, VLANs,
      cabling, and connectivity for homes and acreages in the greater Edmonton
      area.
    </p>
  </Section>

  <Section>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        articles.map((article) => (
          <a
            href={`/articles/${article.id}`}
            class="group border border-line rounded-xl bg-paper p-6 transition-colors hover:border-signal/40"
          >
            <p class="font-mono text-xs text-slate">
              {dateFormatter.format(article.data.pubDate)}
            </p>
            <h3 class="mt-2 font-display font-semibold text-[19px] text-ink transition-colors group-hover:text-signal">
              {article.data.title}
            </h3>
            <p class="mt-2 text-slate leading-relaxed">
              {article.data.description}
            </p>
            <span class="mt-4 inline-block font-medium text-signal">
              Read more →
            </span>
          </a>
        ))
      }
    </div>
  </Section>
</Layout>
