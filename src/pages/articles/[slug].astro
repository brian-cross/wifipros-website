---
import { getCollection, render } from "astro:content";
import Eyebrow from "../../components/Eyebrow.astro";
import Layout from "../../components/layouts/Layout.astro";
import Section from "../../components/Section.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const dateFormatter = new Intl.DateTimeFormat("en-CA", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  title={`${article.data.title} | Wi-Fi Pros`}
  description={article.data.description}
  type="article"
>
  <Section border={false} class="pt-20">
    <Eyebrow> Articles </Eyebrow>
    <h1>{article.data.title}</h1>
    <p class="mt-5 font-mono text-xs text-slate">
      {dateFormatter.format(article.data.pubDate)} · {article.data.author}
    </p>
  </Section>

  <Section>
    <div class="article-body">
      <Content />
    </div>
  </Section>

  <Section>
    <h2>Have a Networking Question?</h2>
    <p class="mt-3 max-w-2xl text-slate leading-relaxed">
      If you're dealing with something similar at your own home or business,
      we're happy to take a look and tell you what we'd recommend.
    </p>
    <div class="mt-6 flex flex-wrap gap-4">
      <a
        href="/quote-request"
        class="bg-signal text-paper font-medium px-6 py-3 rounded-lg hover:bg-signal/90 transition-colors"
      >
        Get a Free Quote
      </a>
      <a
        href="/contact"
        class="border border-line text-ink font-medium px-6 py-3 rounded-lg hover:bg-ink/5 transition-colors"
      >
        Questions? Contact us!
      </a>
    </div>
  </Section>
</Layout>
