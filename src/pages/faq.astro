---
import Bullet from "../components/Bullet.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Layout from "../components/layouts/Layout.astro";
import Section from "../components/Section.astro";
import { faqs } from "../data/faq";
---

<Layout
  title="Frequently Asked Questions | Wi-Fi Pros"
  description="Answers to common questions about Wi-Fi Pros' networking, cabling, camera, and connectivity services in the greater Edmonton area."
>
  <Section border={false} class="pt-20">
    <Eyebrow> Questions & Answers </Eyebrow>
    <h1>Frequently Asked Questions</h1>
    <p class="mt-5 text-slate max-w-xl text-lg">
      Common questions about our services, pricing, and how we work. Don't see
      what you're looking for? <a
        href="/contact"
        class="text-signal hover:underline">Get in touch</a
      >.
    </p>
  </Section>

  <Section>
    <div class="grid gap-3.5" id="faq-accordion">
      {
        faqs.map((faq, i) => (
          <div
            class="faq-card group border border-line rounded-xl overflow-hidden bg-paper data-[open=true]:border-signal/35"
            data-open={i === 0 ? "true" : "false"}
          >
            <button
              class="faq-card-head w-full flex items-center gap-4 px-5 py-5 text-left cursor-pointer focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-signal"
              aria-expanded={i === 0 ? "true" : "false"}
            >
              <Bullet size="md" />
              <span class="flex-1 min-w-0">
                <h3 class="font-display font-bold text-[17px] text-ink">
                  {faq.question}
                </h3>
              </span>
              <svg
                class="h-4.5 w-4.5 text-slate shrink-0 transition-transform duration-250 ease-out motion-reduce:transition-none group-data-[open=true]:rotate-180 group-data-[open=true]:text-signal"
                viewBox="0 0 20 20"
                fill="none"
              >
                <path
                  d="M5 7.5L10 12.5L15 7.5"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 motion-reduce:transition-none group-data-[open=true]:grid-rows-[1fr]">
              <div class="overflow-hidden">
                <div class="px-5 pb-5 pt-4 border-t border-line ml-[2.375rem]">
                  <p class="text-sm text-slate leading-relaxed">{faq.answer}</p>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </Section>
</Layout>

<script>
  const accordion = document.getElementById("faq-accordion");
  const buttons = accordion?.querySelectorAll(".faq-card-head");

  buttons?.forEach((button) => {
    button.addEventListener("click", () => {
      const card = button.closest(".faq-card");
      const isOpen = card?.getAttribute("data-open") === "true";
      card?.setAttribute("data-open", String(!isOpen));
      button.setAttribute("aria-expanded", String(!isOpen));
    });
  });
</script>
