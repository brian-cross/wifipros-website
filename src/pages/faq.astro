---
import Accordion from "../components/Accordion.astro";
import AccordionItem from "../components/AccordionItem.astro";
import Bullet from "../components/Bullet.astro";
import Eyebrow from "../components/Eyebrow.astro";
import JsonLd from "../components/JsonLd.astro";
import Layout from "../components/layouts/Layout.astro";
import Section from "../components/Section.astro";
import { faqs } from "../data/faq";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<Layout
  title="Frequently Asked Questions | Wi-Fi Pros"
  description="Answers to common questions about Wi-Fi Pros' networking, cabling, camera, and connectivity services in the greater Edmonton area."
>
  <Fragment slot="json-ld">
    <JsonLd data={faqSchema} />
  </Fragment>

  <Section border={false} class="pt-20">
    <Eyebrow> Questions & Answers </Eyebrow>
    <h1>Frequently Asked Questions</h1>
    <p class="mt-5 text-slate max-w-xl text-lg">
      Common questions about our services, pricing, and how we work. Don't see
      what you're looking for? <a
        href="/contact"
        class="text-signal underline">Get in touch</a
      >.
    </p>
  </Section>

  <Section>
    <Accordion id="faq-accordion">
      {
        faqs.map((faq, i) => (
          <AccordionItem open={i === 0}>
            <Fragment slot="head">
              <Bullet size="md" />
              <span class="flex-1 min-w-0">
                <h3 class="font-display font-bold text-[17px] text-ink">
                  {faq.question}
                </h3>
              </span>
            </Fragment>
            <div class="px-5 pb-5 pt-4 border-t border-line ml-9.5">
              <p class="text-sm text-slate leading-relaxed">{faq.answer}</p>
            </div>
          </AccordionItem>
        ))
      }
    </Accordion>
  </Section>
</Layout>
