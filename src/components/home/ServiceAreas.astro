---
import Bullet from "../../components/Bullet.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Section from "../../components/Section.astro";
import { cities } from "../../data/cities";
---

<Section>
  <Eyebrow>
    <Bullet pulse />
    Service Areas
  </Eyebrow>
  <h2>Proudly Serving the Greater Edmonton Area</h2>
  <p class="mt-3 text-slate max-w-2xl">
    From city lots to quarter-section acreages, we bring the same
    enterprise-grade approach everywhere we work.
  </p>
  <ul class="mt-6 flex flex-wrap gap-x-2 gap-y-3 font-mono text-sm">
    {
      cities.map((city) => (
        <li class="flex items-center">
          <a
            href={`/service-areas/${city.slug}`}
            class="text-signal hover:underline"
          >
            {city.name}
          </a>
          <span class="text-line ml-2">·</span>
        </li>
      ))
    }
    <li class="flex items-center">
      <a
        href="/service-areas/rural-acreage"
        class="text-signal hover:underline"
      >
        Rural &amp; Acreage Properties
      </a>
    </li>
  </ul>
  <a
    href="/contact"
    class="mt-6 inline-block font-medium text-signal hover:underline"
  >
    Don't see your area? Reach out and we'll let you know if we can help.
  </a>
</Section>
