---
import "../../styles/global.css";
import { business } from "../../data/business";
import { cities } from "../../data/cities";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import JsonLd from "../JsonLd.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
}
const {
  title,
  description,
  image = "/og-image.png",
  imageAlt = `${business.name} logo`,
  type = "website",
} = Astro.props;

const normalizedPath =
  Astro.url.pathname === "/index.html"
    ? "/"
    : Astro.url.pathname.replace(/\.html$/, "");
const canonicalUrl = new URL(normalizedPath, Astro.site);
const ogImageUrl = new URL(image, Astro.site);

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: business.name,
  legalName: business.legalName,
  url: new URL("/", Astro.site).toString(),
  logo: new URL("/favicon.png", Astro.site).toString(),
  image: new URL("/og-image.png", Astro.site).toString(),
  telephone: business.phone.replace(/[^\d+]/g, ""),
  email: business.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Sherwood Park",
    addressRegion: "AB",
    addressCountry: "CA",
  },
  areaServed: cities.map((city) => city.name),
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
    ],
    opens: "09:00",
    closes: "17:00",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0559c9" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap"
      />
    </noscript>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    {description && (
      <meta property="og:description" content={description} />
    )}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_CA" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && (
      <meta name="twitter:description" content={description} />
    )}
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <JsonLd data={localBusinessSchema} />
    <slot name="json-ld" />

    <!-- Privacy-friendly analytics by Plausible -->
    <script is:inline async src="https://plausible.io/js/pa-Cr0W9evv4_OrXNX6b_4Zk.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body class="font-body">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-60 focus:rounded-lg focus:bg-signal focus:px-4 focus:py-2 focus:font-medium focus:text-paper"
    >
      Skip to main content
    </a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
