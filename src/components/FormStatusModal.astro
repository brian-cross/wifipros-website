---
interface Props {
  idPrefix: string;
  loadingText: string;
  successHeading: string;
  successMessage: string;
  errorHeading?: string;
  errorMessage: string;
}

const {
  idPrefix,
  loadingText,
  successHeading,
  successMessage,
  errorHeading = "Something Went Wrong",
  errorMessage,
} = Astro.props;

const focusRingClass =
  "focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal";
---

<div
  id={`${idPrefix}-modal`}
  hidden
  class="fixed inset-0 z-50 flex items-center justify-center p-4"
>
  <div id={`${idPrefix}-modal-backdrop`} class="absolute inset-0 bg-ink/60">
  </div>
  <div
    id={`${idPrefix}-modal-panel`}
    role="dialog"
    aria-modal="true"
    aria-label="Form status"
    tabindex="-1"
    class="relative w-full max-w-md rounded-lg bg-paper p-8 shadow-xl focus:outline-none"
  >
    <button
      type="button"
      id={`${idPrefix}-modal-close`}
      aria-label="Close"
      class={`absolute right-4 top-4 cursor-pointer text-slate hover:text-ink transition-colors ${focusRingClass}`}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
      >
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>

    <div id={`${idPrefix}-modal-content`} aria-live="polite" class="text-center">
      <div data-modal-state="loading" class="py-4">
        <div
          class="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-line border-t-signal"
        >
        </div>
        <p class="mt-4 font-medium text-ink">{loadingText}</p>
      </div>

      <div data-modal-state="success" hidden class="py-4">
        <div
          class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-green-600/10 text-green-600"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6"
          >
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </div>
        <h2 class="mt-4">{successHeading}</h2>
        <p class="mt-2 text-slate leading-relaxed">{successMessage}</p>
      </div>

      <div data-modal-state="error" hidden class="py-4">
        <div
          class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-red-600/10 text-red-600"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6"
          >
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </div>
        <h2 class="mt-4">{errorHeading}</h2>
        <p class="mt-2 text-slate leading-relaxed">{errorMessage}</p>
        <button
          type="button"
          id={`${idPrefix}-modal-retry`}
          class={`mt-4 cursor-pointer font-medium text-signal hover:underline ${focusRingClass}`}
        >
          Try again
        </button>
      </div>
    </div>
  </div>
</div>
